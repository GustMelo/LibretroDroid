+
+#ifndef _WIN32
+// A peer that stops answering (paused, backgrounded, gone) must never freeze
+// the emulation thread: blocking reads give up and the link reconnects.
+static const int IO_TIMEOUT_MS = 2000;
+static const int CONNECT_TIMEOUT_MS = 1000;
+
+static void configureLinkSocket(int fd)
+{
+	int one = 1;
+	setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+#ifdef SO_NOSIGPIPE
+	setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#endif
+	struct timeval tv;
+	tv.tv_sec = IO_TIMEOUT_MS / 1000;
+	tv.tv_usec = (IO_TIMEOUT_MS % 1000) * 1000;
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+}
+
+static long monotonicMs()
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static bool connectWithTimeout(int fd, const struct sockaddr* addr, socklen_t len)
+{
+	int flags = fcntl(fd, F_GETFL, 0);
+	fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+	int result = connect(fd, addr, len);
+	if (result < 0 && errno == EINPROGRESS) {
+		struct pollfd pfd;
+		pfd.fd = fd;
+		pfd.events = POLLOUT;
+		pfd.revents = 0;
+		int error = 0;
+		socklen_t size = sizeof(error);
+		result = poll(&pfd, 1, CONNECT_TIMEOUT_MS) == 1 &&
+			getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size) == 0 && error == 0 ? 0 : -1;
+		if (result < 0 && error)
+			errno = error;
+	}
+	fcntl(fd, F_SETFL, flags);
+	return result == 0;
+}
+
+// Reads exactly two bytes; a short read would desynchronize the byte pairs.
+static bool readPair(int fd, unsigned char* buffer)
+{
+	size_t got = 0;
+	while (got < 2) {
+		ssize_t n = read(fd, buffer + got, 2 - got);
+		if (n <= 0)
+			return false;
+		got += n;
+	}
+	return true;
+}
+
+static bool writePair(int fd, const unsigned char* buffer)
+{
+#ifdef MSG_NOSIGNAL
+	return ::send(fd, buffer, 2, MSG_NOSIGNAL) == 2;
+#else
+	return ::send(fd, buffer, 2, 0) == 2;
+#endif
+}
 #endif
 
