 std::atomic<bool> s_stop_frame_step;
 
+#ifdef __LIBRETRO__
+// Dual core under a frontend that asks for one field per retro_run(): the fields it asked for and the ones the
+// CPU thread finished. The CPU thread works one field ahead of the frontend, so the console's CPU is emulated
+// while the frontend draws and presents the field before, and stops only when it gets further ahead than that.
+// Pausing it at every field instead left it idle through all of that, and the two threads took turns.
+static u32 s_fields_requested = 0;
+static u32 s_fields_finished = 0;
+static constexpr s32 FIELDS_AHEAD = 1;
+// Held while either thread counts a field and acts on it: the CPU thread deciding to stop and the frontend's
+// thread deciding it has nothing to wake must not cross, or both end up waiting for the other.
+static std::mutex s_fields_mutex;
+#endif
+
 // Threads other than the CPU thread must hold this when taking on the role of the CPU thread.
 // The CPU thread is not required to hold this when doing normal work, but must hold it if writing
 // to s_state.
@@ -565,6 +578,13 @@ void EmuThread(Core::System& system, std::unique_ptr<BootParameters> boot,
   }};
 
   Common::SetCurrentThreadName("Emuthread - Starting");
+#ifdef __LIBRETRO__
+  {
+    std::lock_guard fields_lock(s_fields_mutex);
+    s_fields_requested = 0;
+    s_fields_finished = 0;
+  }
+#endif
 
   // This will become the CPU thread.
   DeclareAsCPUThread();
@@ -981,6 +1001,25 @@ void Callback_FramePresented(const PresentInfo& present_info)
 // Called from VideoInterface::Update (CPU thread) at emulated field boundaries
 void Callback_NewField(Core::System& system)
 {
+#ifdef __LIBRETRO__
+  if (system.IsDualCoreMode())
+  {
+    bool stopped = false;
+    {
+      std::lock_guard fields_lock(s_fields_mutex);
+      stopped = static_cast<s32>(++s_fields_finished - s_fields_requested) >= FIELDS_AHEAD;
+      if (stopped)
+        system.GetCPU().Break();
+    }
+    if (stopped)
+      NotifyStateChanged(Core::GetState(system));
+    // A field is ready: the frontend's thread leaves the GPU loop once it has drawn it. Said after stopping, so
+    // that whenever it comes back for the next one it finds this thread stopped and wakes it.
+    system.GetFifo().StopGpuLoop();
+    AchievementManager::GetInstance().DoFrame();
+    return;
+  }
+#endif
   if (s_frame_step)
   {
 #ifndef __LIBRETRO__
@@ -1145,6 +1184,18 @@ void DoFrameStep(Core::System& system)
   }
 }
 
+#ifdef __LIBRETRO__
+void RequestField(Core::System& system)
+{
+  std::lock_guard lock(s_core_mutex);
+  std::lock_guard fields_lock(s_fields_mutex);
+  ++s_fields_requested;
+  // A CPU thread that is still running is working on this field or on the one after it.
+  if (GetState(system) == State::Paused)
+    SetState(system, State::Running, false);
+}
+#endif
