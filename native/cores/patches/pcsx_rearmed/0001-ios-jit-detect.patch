 #define _GNU_SOURCE 1 // strcasestr
 #include <stdio.h>
+#if defined(IOS) && !defined(DRC_DISABLE)
+/* LibretroDroid: no iOS o dynarec só roda com JIT liberado (processo com depurador: Xcode,
+ * StikDebug). Sem JIT, mmap executável derruba o app: fica no interpretador, como no 3DS. */
+#include <unistd.h>
+int csops(pid_t pid, unsigned int ops, void *useraddr, size_t usersize);
+static int ios_jit_available(void)
+{
+   int flags = 0;
+   return csops(getpid(), 0 /* CS_OPS_STATUS */, &flags, sizeof(flags)) == 0
+      && (flags & 0x10000000 /* CS_DEBUGGED */) != 0;
+}
+#endif
