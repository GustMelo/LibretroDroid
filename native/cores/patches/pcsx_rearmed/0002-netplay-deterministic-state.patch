 	gzfreeze(&mdec.reg1, sizeof(mdec.reg1));
 
-	v = (u8 *)mdec.rl - base;
+	// LibretroDroid: save the same masked offsets a load produces
+	v = ((u8 *)mdec.rl - base) & 0x1ffffe;
