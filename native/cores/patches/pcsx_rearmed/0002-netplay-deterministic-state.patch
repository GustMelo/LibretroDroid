@@ -724,7 +725,7 @@ int mdecFreeze(void *f, int Mode) {
 	gzfreeze(&v, sizeof(v));
 	mdec.block_buffer_pos = 0;
 	if (v && v < sizeof(mdec.block_buffer))
-		mdec.block_buffer_pos = mdec.block_buffer;
+		mdec.block_buffer_pos = mdec.block_buffer + v; // LibretroDroid: was reset to the start, losing the position
 
