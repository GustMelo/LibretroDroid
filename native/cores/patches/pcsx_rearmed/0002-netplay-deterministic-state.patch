       memcpy(freeze->ulControl + 0xe0, gpu.ex_regs, sizeof(gpu.ex_regs));
+      // LibretroDroid: keep the GPUREAD latch, loads must reproduce the live GPU exactly (netplay rollback)
+      freeze->ulControl[0xf0] = gpu.gp0;
