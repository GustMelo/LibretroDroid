diff --git a/libpcsxcore/misc.c b/libpcsxcore/misc.c
index ea102b3..8ef10b4 100644
--- a/libpcsxcore/misc.c
+++ b/libpcsxcore/misc.c
@@ -797,6 +797,9 @@ int SaveState(const char *file) {
 	misc->CdromFrontendId = CdromFrontendId;
 	misc->save_counter = ++save_counter;
 	memset(misc->reserved, 0, sizeof(misc->reserved));
+	/* LibretroDroid: the interpreter's fractional cycle (cycle_multiplier 175 = 1.75/op) must survive
+	 * save/load, or every netplay rollback drops up to 0.75 cycle and peers drift apart. */
+	misc->reserved[0] = psxRegs.subCycle;
 
 	psxCpu->Notify(R3000ACPU_NOTIFY_BEFORE_SAVE, NULL);
 
@@ -864,6 +867,8 @@ int LoadState(const char *file) {
 	struct misc_save_data *misc = (void *)(psxRegs.ptrs.psxH + 0xf000);
 	u32 biosBranchCheckOld = psxRegs.biosBranchCheck;
 	u32 oldCP0sr = psxRegs.CP0.n.SR;
+	u32 subCycle = 0;
+	u32 gpuSr = 0, haveMisc = 0;
 	union {
 		// save stack space
 		GPUFreeze_t gpu_hdr;
@@ -938,6 +943,9 @@ int LoadState(const char *file) {
 		CdromFrontendId = misc->CdromFrontendId;
 		if (misc->save_counter)
 			save_counter = misc->save_counter;
+		subCycle = misc->reserved[0] & 0xffff;
+		gpuSr = misc->gpuSr;
+		haveMisc = 1;
 	}
 
 	if (Config.HLE)
@@ -949,6 +957,10 @@ int LoadState(const char *file) {
 	assert(vram);
 	SaveFuncs.read(f, vram, 1024*512*2);
 	gpuSyncPluginSR();
+	/* LibretroDroid: HW_GPU_STATUS is a lazily synced copy that DMA timing reads directly;
+	 * keep the saved (possibly stale) value so a load behaves exactly like the live run. */
+	if (haveMisc)
+		HW_GPU_STATUS = gpuSr;
 
 	// spu
 	SaveFuncs.read(f, &Size, 4);
@@ -989,6 +1001,7 @@ int LoadState(const char *file) {
 		psxMemOnIsolate((psxRegs.CP0.n.SR >> 16) & 1);
 
 	psxCpu->Notify(R3000ACPU_NOTIFY_AFTER_LOAD_STATE, NULL);
+	psxRegs.subCycle = subCycle;
 
 	result = 0;
 cleanup:
diff --git a/libpcsxcore/psxcounters.c b/libpcsxcore/psxcounters.c
index 471980e..a88f745 100644
--- a/libpcsxcore/psxcounters.c
+++ b/libpcsxcore/psxcounters.c
@@ -603,9 +603,9 @@ s32 psxRcntFreeze( void *f, s32 Mode )
         for( i = 0; i < CounterQuantity - 1; ++i )
         {
             _psxRcntWmode( i, rcnts[i].mode );
-            count = (psxRegs.cycle - rcnts[i].cycleStart) / rcnts[i].rate;
-            if (count > 0x1000)
-                _psxRcntWcount( i, count & 0xffff );
