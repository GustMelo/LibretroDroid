+      memcpy(gpu.regs, freeze->ulControl, sizeof(gpu.regs));
+      gpu.gp0 = freeze->ulControl[0xf0];
       renderer_sync_ecmds(gpu.ex_regs);
       renderer_update_caches(0, 0, 1024, 512, 0);
       gpu_async_sync_ecmds(&gpu);
